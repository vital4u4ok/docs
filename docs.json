          "GET /accounts/{accountId}/transactions/export",
          "GET /events",
          "GET /payments/{paymentId}",
          "GET /reports/balances",
          "POST /documents",
          "POST /documents/batch",
          "GET /cards/{cardId}",
          "GET /branches/{branchId}/atms/{coords}",
          "GET /fx/rates",
          "GET /fx/quotes",
          "GET /ping",
          "POST /accounts/{accountId}/postings/query",
          "POST /payments/{paymentId}/hold",
          "DELETE /payments/{paymentId}/hold"
        ]
      },
      {
        "group": "About this description",
        "pages": [
          "openapi-3-2"
        ]
      }
